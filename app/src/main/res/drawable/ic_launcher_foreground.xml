<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dynamic Orbiting Neon Accent Arcs (Spans comfortably across the safe zone) -->
    <path
        android:pathData="M23,32 C34,20 74,20 85,32 M23,76 C34,88 74,88 85,76"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="20"
                android:endX="85"
                android:endY="88"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#818CF8" android:offset="0.5" />
                <item android:color="#D946EF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Frame Drop Glow Shadow -->
    <path
        android:pathData="M24,28 h60 a6,6 0 0,1 6,6 v36 a6,6 0 0,1 -6,6 h-60 a6,6 0 0,1 -6,-6 v-36 a6,6 0 0,1 6,-6 z"
        android:fillColor="#334F46E5" />

    <!-- Premium Beveled TV Outer Frame -->
    <path
        android:pathData="M25,29 h58 a5,5 0 0,1 5,5 v34 a5,5 0 0,1 -5,5 h-58 a5,5 0 0,1 -5,-5 v-34 a5,5 0 0,1 5,-5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="29"
                android:endX="86"
                android:endY="73"
                android:type="linear">
                <item android:color="#818CF8" android:offset="0.0" />
                <item android:color="#4F46E5" android:offset="0.5" />
                <item android:color="#C084FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Screen Glassmorphic Glossy Inner Panel -->
    <path
        android:pathData="M28,32 h52 a3,3 0 0,1 3,3 v28 a3,3 0 0,1 -3,3 h-52 a3,3 0 0,1 -3,-3 v-28 a3,3 0 0,1 3,-3 z"
        android:fillColor="#0B0F19" />

    <!-- Sleek Neon Accent Reflection Line on Screen Top -->
    <path
        android:pathData="M29,32.5 h50"
        android:strokeWidth="1"
        android:strokeColor="#A5B4FC" />

    <!-- TV Stand Neck & Base -->
    <path
        android:pathData="M54,73 L47,82 H61 Z"
        android:fillColor="#818CF8" />
    <path
        android:pathData="M41,82 H67"
        android:strokeWidth="2"
        android:strokeColor="#818CF8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M39,84 H69"
        android:strokeWidth="1"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- Center 'Aura' Neon Play Glass Triangle Symbol -->
    <path
        android:pathData="M48,39 L63,48 L48,57 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="39"
                android:endX="63"
                android:endY="57"
                android:type="linear">
                <item android:color="#22D3EE" android:offset="0.0" />
                <item android:color="#818CF8" android:offset="0.5" />
                <item android:color="#EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
