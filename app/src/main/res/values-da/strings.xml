    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Tryk på D-Pad combo: OP, OP, NED, VENSTRE for at låse op eller låse skjulte hvælvingsapplikationer.</string>
    <string name="help_mic_title">Mikrofon / Assistent knap</string>
