    <string name="help_dpad_desc">Naviger gennem app-ikoner, gitter, øverste overskriftslinje, søgelinje og tilpassede kategorimapper.</string>
    <string name="help_long_press_title">Langt tryk på OK / Vælg</string>
    <string name="help_long_press_desc">Åbner appens kontekstmenu for at udløse dybt stop, indstille brugerdefinerede genvejstaster eller redigere brugerdefinerede bannere.</string>
    <string name="help_settings_title">Menutast / Indstillinger-ikon</string>
