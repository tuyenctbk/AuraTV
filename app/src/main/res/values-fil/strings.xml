    <string name="help_dpad_desc">Mag-navigate sa grid ng mga icon ng app, top header bar, search bar, at mga folder ng custom na kategorya.</string>
    <string name="help_long_press_title">Pindutin nang matagal ang OK / Piliin</string>
    <string name="help_long_press_desc">Binubuksan ang Menu ng Konteksto ng App upang ma-trigger ang Deep Stop, magtakda ng mga custom na hotkey, o mag-edit ng mga custom na banner.</string>
    <string name="help_settings_title">Menu Key / Icon ng Mga Setting</string>
    <string name="help_settings_desc">Binubuksan ang Mga Setting ng Launcher (4K Wallpaper engine, custom na kulay ng accent, performance cache cleaner).</string>
    <string name="help_hotkey_title">Mga Susi ng Numero (0 - 9)</string>
    <string name="help_hotkey_desc">Agad na naglulunsad ng mga naka-map na hotkey na application mula saanman sa launcher.</string>
    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Pindutin ang D-Pad combo: UP, UP, DOWN, LEFT para i-unlock o i-lock ang mga nakatagong vault application.</string>
    <string name="help_mic_title">Button ng Mic / Assistant</string>
    <string name="help_mic_desc">Nagti-trigger ng voice-to-text na tagapakinig sa paghahanap sa mga sinusuportahang Android TV remote.</string>
    <string name="vault_title">Stealth Vault Unlock</string>
    <string name="vault_desc">Ilagay ang code (Default: GHOST) o pindutin ang D-Pad sequence UP, UP, DOWN, LEFT sa home screen.</string>
    <string name="vault_invalid_passcode">Di-wastong Passcode</string>
    <string name="transparency_title">Transparency ng Pagtuklas ng App</string>
    <string name="transparency_desc">Ang Aura TV ay nangangailangan ng pahintulot upang i-scan ang mga naka-install na application (QUERY_ALL_PACKAGES). Ito ay kinakailangan upang awtomatikong makita at maipakita ang parehong mga native na app sa TV at naka-sideload na mga mobile app sa iyong device.

Ang Aura TV ay 100% open-source, walang ad, at nirerespeto ang iyong privacy. Walang personal na data o listahan ng app ang nakolekta o naipadala.</string>
    <string name="transparency_accept">Naiintindihan Ko at Tinatanggap Ko</string>
    <string name="onboarding_welcome_title">Maligayang pagdating sa Aura TV</string>
    <string name="onboarding_welcome_desc">Isang napakabilis ng kidlat, minimalist na Android TV launcher na idinisenyo para sa walang hirap na pag-navigate, malalim na pag-customize, at malinis na aesthetics.</string>
    <string name="onboarding_cats_title">Mga Kategorya ng Smart App</string>
    <string name="onboarding_cats_desc">Ayusin nang maayos ang iyong mga streaming app, laro, at naka-sideload na utility sa mga custom na header ng seksyon ng row na may mga live na bilang ng app.</string>
    <string name="onboarding_oled_title">Proteksyon sa Burn-In ng OLED</string>
    <string name="onboarding_oled_desc">Protektahan ang iyong TV display gamit ang mga na-configure na inactivity timer na awtomatikong nagti-trigger ng isang OLED-safe ambient black screen.</string>
    <string name="hotkey_dialog_title">Map Hotkey: %1$s</string>
    <string name="hotkey_dialog_desc">Pindutin ang remote na number key (0-9) sa launcher upang agad na ilunsad ang application na ito.</string>
    <string name="category_dialog_title">Dynamic na Kategorya: %1$s</string>
    <string name="category_dialog_desc">Pumili ng kasalukuyang folder ng kategorya o mag-type ng bago.</string>
    <string name="create_category_hint">Gumawa ng bagong pangalan ng folder...</string>
    <string name="banner_dialog_title">Tagaayos ng Banner: %1$s</string>
    <string name="banner_dialog_desc">Ilagay ang path ng lokal na file o URL ng larawan para sa custom na 16:9 na banner.
Tip: I-save ang mga larawan sa /sdcard/AuraTV/Banners/%1$s.png para sa auto-detection.</string>
