    <string name="help_dpad_title">Flèches du D-Pad (Haut/Bas/Gauche/Droite)</string>
    <string name="help_dpad_desc">Naviguez dans la grille des icônes d\'application, la barre d\'en-tête supérieure, la barre de recherche et les dossiers de catégories personnalisées.</string>
    <string name="help_long_press_title">Appuyez longuement sur OK/Sélectionner</string>
    <string name="help_long_press_desc">Ouvre le menu contextuel de l\'application pour déclencher Deep Stop, définir des raccourcis clavier personnalisés ou modifier des bannières personnalisées.</string>
    <string name="help_settings_title">Touche Menu / Icône Paramètres</string>
    <string name="help_settings_desc">Ouvre les paramètres du lanceur (moteur de fond d\'écran 4K, couleurs d\'accent personnalisées, nettoyeur de cache de performances).</string>
    <string name="help_hotkey_title">Touches numériques (0 - 9)</string>
    <string name="help_hotkey_desc">Lance instantanément les applications de raccourcis clavier mappées depuis n\'importe où sur le lanceur.</string>
    <string name="help_vault_title">Combo de coffre-fort furtif</string>
    <string name="help_vault_desc">Appuyez sur la combinaison D-Pad : HAUT, HAUT, BAS, GAUCHE pour déverrouiller ou verrouiller les applications cachées du coffre-fort.</string>
    <string name="help_mic_title">Bouton Micro/Assistant</string>
    <string name="help_mic_desc">Déclenche l\'écouteur de recherche voix-texte sur les télécommandes Android TV prises en charge.</string>
    <string name="vault_title">Déverrouillage du coffre-fort furtif</string>
    <string name="vault_desc">Entrez le code (par défaut : GHOST) ou appuyez sur la séquence D-Pad HAUT, HAUT, BAS, GAUCHE sur l\'écran d\'accueil.</string>
    <string name="vault_invalid_passcode">Code d\'accès invalide</string>
    <string name="transparency_title">Transparence de la découverte des applications</string>
    <string name="transparency_desc">Aura TV nécessite l\'autorisation d\'analyser les applications installées (QUERY_ALL_PACKAGES). Cela est nécessaire pour détecter et afficher automatiquement les applications TV natives et les applications mobiles téléchargées sur votre appareil.

Aura TV est 100 % open source, sans publicité et respecte votre vie privée. Aucune donnée personnelle ni liste d\'applications n\'est jamais collectée ou transmise.</string>
    <string name="transparency_accept">Je comprends et j\'accepte</string>
    <string name="onboarding_welcome_title">Bienvenue sur Aura TV</string>
    <string name="onboarding_welcome_desc">Un lanceur Android TV ultra-rapide et minimaliste conçu pour une navigation sans effort, une personnalisation approfondie et une esthétique épurée.</string>
    <string name="onboarding_cats_title">Catégories d\'applications intelligentes</string>
    <string name="onboarding_cats_desc">Organisez soigneusement vos applications de streaming, vos jeux et vos utilitaires téléchargés dans des en-têtes de section de lignes personnalisés avec le nombre d\'applications en direct.</string>
    <string name="onboarding_oled_title">Protection contre le rodage OLED</string>
    <string name="onboarding_oled_desc">Protégez l\'écran de votre téléviseur avec des minuteries d\'inactivité configurables qui déclenchent automatiquement un écran noir ambiant sécurisé OLED.</string>
    <string name="hotkey_dialog_title">Touche de raccourci de carte : %1$s</string>
    <string name="hotkey_dialog_desc">Appuyez sur une touche numérique distante (0-9) sur le lanceur pour lancer instantanément cette application.</string>
    <string name="category_dialog_title">Catégorie dynamique : %1$s</string>
    <string name="category_dialog_desc">Sélectionnez un dossier de catégorie existant ou saisissez-en un nouveau.</string>
