    <string name="help_dpad_title">חצים D-Pad (מעלה / למטה / שמאלה / ימינה)</string>
    <string name="help_dpad_desc">נווט דרך רשת סמלי האפליקציה, סרגל הכותרות העליון, סרגל החיפוש ותיקיות קטגוריות מותאמות אישית.</string>
    <string name="help_long_press_title">לחץ לחיצה ארוכה על OK / Select</string>
    <string name="help_long_press_desc">פותח את תפריט ההקשר של האפליקציה כדי להפעיל עצירה עמוקה, להגדיר מקשי קיצור מותאמים אישית או לערוך באנרים מותאמים אישית.</string>
    <string name="help_settings_title">מקש תפריט / סמל הגדרות</string>
    <string name="help_settings_desc">פותח את הגדרות המשגר (מנוע טפטים 4K, צבעי מבטא מותאמים אישית, מנקה מטמון ביצועים).</string>
    <string name="help_hotkey_title">מקשי מספרים (0 - 9)</string>
    <string name="help_hotkey_desc">מפעיל באופן מיידי יישומי מקשים חמים ממופים מכל מקום במפעיל.</string>
    <string name="help_vault_title">קומבו של כספת התגנבות</string>
    <string name="help_vault_desc">לחץ על D-Pad משולבת: למעלה, למעלה, למטה, שמאלה כדי לפתוח או לנעול יישומי כספת נסתרים.</string>
    <string name="help_mic_title">כפתור מיקרופון / עוזר</string>
    <string name="help_mic_desc">מפעיל מאזין חיפוש קול לטקסט בשלטים נתמכים של Android TV.</string>
    <string name="vault_title">פתיחת נעילה של כספת התגנבות</string>
    <string name="vault_desc">הזן קוד (ברירת מחדל: GHOST) או לחץ על D-Pad רצף למעלה, למעלה, למטה, שמאלה במסך הבית.</string>
    <string name="vault_invalid_passcode">קוד סיסמה לא חוקי</string>
    <string name="transparency_title">שקיפות גילוי אפליקציה</string>
    <string name="transparency_desc">Aura TV דורש הרשאה לסרוק יישומים מותקנים (QUERY_ALL_PACKAGES). זה הכרחי כדי לזהות ולהציג באופן אוטומטי הן אפליקציות טלוויזיה מקוריות והן אפליקציות סלולריות בעלות צד במכשיר שלך.

Aura TV היא 100% קוד פתוח, ללא פרסומות ומכבדת את הפרטיות שלך. אף מידע אישי או רשימת אפליקציות לא נאספים או מועברים לעולם.</string>
    <string name="transparency_accept">אני מבין ומקבל</string>
    <string name="onboarding_welcome_title">ברוכים הבאים ל-Aura TV</string>
    <string name="onboarding_welcome_desc">משגר אנדרואיד TV מהיר בזק ומינימליסטי המיועד לניווט ללא מאמץ, התאמה אישית עמוקה ואסתטיקה נקייה.</string>
    <string name="onboarding_cats_title">קטגוריות אפליקציות חכמות</string>
    <string name="onboarding_cats_desc">ארגן את אפליקציות הסטרימינג, המשחקים וכלי השירות הטעונים בצורה מסודרת בכותרות מותאמות אישית של קטעי שורות עם ספירת אפליקציות חיה.</string>
    <string name="onboarding_oled_title">הגנה מפני צריבה של OLED</string>
    <string name="onboarding_oled_desc">הגן על תצוגת הטלוויזיה שלך עם טיימרים ניתנים להגדרה של חוסר פעילות המפעילים מסך שחור סביבתי בטוח ב-OLED באופן אוטומטי.</string>
