    <string name="help_hotkey_title">संख्या कुंजियाँ (0 - 9)</string>
    <string name="help_hotkey_desc">लॉन्चर पर कहीं से भी मैप किए गए हॉटकी एप्लिकेशन को तुरंत लॉन्च करता है।</string>
    <string name="help_vault_title">स्टील्थ वॉल्ट कॉम्बो</string>
    <string name="help_vault_desc">छिपे हुए वॉल्ट एप्लिकेशन को अनलॉक या लॉक करने के लिए डी-पैड कॉम्बो दबाएं: ऊपर, ऊपर, नीचे, बाएँ।</string>
    <string name="help_mic_title">माइक/सहायक बटन</string>
