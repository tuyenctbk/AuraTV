    <string name="hotkey_dialog_desc">इस एप्लिकेशन को तुरंत लॉन्च करने के लिए लॉन्चर पर रिमोट नंबर कुंजी (0-9) दबाएं।</string>
    <string name="category_dialog_title">गतिशील श्रेणी: %1$s</string>
