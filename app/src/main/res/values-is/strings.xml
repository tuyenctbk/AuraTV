    <string name="help_dpad_desc">Farðu í gegnum hnitanet apptákn, efstu hausstikuna, leitarstikuna og sérsniðnar flokkamöppur.</string>
    <string name="help_long_press_title">Ýttu lengi á OK / Velja</string>
    <string name="help_long_press_desc">Opnar samhengisvalmynd forritsins til að kveikja á Deep Stop, stilla sérsniðna flýtilykla eða breyta sérsniðnum borðum.</string>
    <string name="help_settings_title">Valmyndartákn / Stillingartákn</string>
