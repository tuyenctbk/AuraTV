    <string name="help_hotkey_title">Talnalyklar (0 - 9)</string>
    <string name="help_hotkey_desc">Opnar samstundis kortlögð flýtilyklaforrit hvar sem er á ræsiforritinu.</string>
    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Ýttu á D-Pad combo: UPP, UPP, NIÐUR, VINSTRI til að opna eða læsa falnum hvelfingarforritum.</string>
    <string name="help_mic_title">Hljóðnemi / Aðstoðarhnappur</string>
    <string name="help_mic_desc">Kveikir á radd-í-textaleitar hlustandi á studdum Android TV fjarstýringum.</string>
    <string name="vault_title">Laumuhrafn af lás</string>
    <string name="vault_desc">Sláðu inn kóða (sjálfgefið: GHOST) eða ýttu á D-Pad röð UPP, UPP, NIÐUR, VINSTRI á heimaskjánum.</string>
    <string name="vault_invalid_passcode">Ógildur aðgangskóði</string>
    <string name="transparency_title">Gagnsæi App Discovery</string>
    <string name="transparency_desc">Aura TV krefst leyfis til að skanna uppsett forrit (QUERY_ALL_PACKAGES). Þetta er nauðsynlegt til að greina og birta sjálfkrafa bæði innfædd sjónvarpsforrit og hliðhlaðin farsímaforrit á tækinu þínu.

Aura TV er 100% opinn hugbúnaður, auglýsingalaus og virðir friðhelgi þína. Engum persónulegum gögnum eða forritalista er aldrei safnað eða sent.</string>
    <string name="transparency_accept">Ég skil og samþykki</string>
    <string name="onboarding_welcome_title">Velkomin í Aura TV</string>
    <string name="onboarding_welcome_desc">Eldingarfljótur, naumhyggjulegur Android TV sjósetja hannaður fyrir áreynslulausa siglingu, djúpa sérstillingu og hreina fagurfræði.</string>
    <string name="onboarding_cats_title">Snjallforritaflokkar</string>
    <string name="onboarding_cats_desc">Skipuleggðu streymisforritin þín, leiki og hliðarhleðslutæki snyrtilega í sérsniðna raðhlutahausa með lifandi forritatalningum.</string>
    <string name="onboarding_oled_title">OLED-innbrennsluvörn</string>
    <string name="onboarding_oled_desc">Verndaðu sjónvarpsskjáinn þinn með stillanlegum óvirknitímamælum sem kveikja sjálfkrafa á OLED-öruggum svartan skjá.</string>
    <string name="hotkey_dialog_title">Hraðlykill kort: %1$s</string>
    <string name="hotkey_dialog_desc">Ýttu á fjarstýrðan númeratakka (0-9) á ræsiforritinu til að ræsa þetta forrit samstundis.</string>
    <string name="category_dialog_title">Kvikur flokkur: %1$s</string>
    <string name="category_dialog_desc">Veldu núverandi flokkamöppu eða sláðu inn nýja.</string>
    <string name="create_category_hint">Búðu til nýtt möppuheiti...</string>
