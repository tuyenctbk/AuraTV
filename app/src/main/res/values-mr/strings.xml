    <string name="help_hotkey_title">नंबर की (0 - 9)</string>
    <string name="help_hotkey_desc">लाँचरवर कुठूनही मॅप केलेले हॉटकी ऍप्लिकेशन्स झटपट लॉन्च करते.</string>
    <string name="help_vault_title">स्टेल्थ व्हॉल्ट कॉम्बो</string>
    <string name="help_vault_desc">D-Pad कॉम्बो दाबा: UP, UP, DOWN, LEFT लपविलेले वॉल्ट ॲप्लिकेशन अनलॉक किंवा लॉक करण्यासाठी.</string>
    <string name="help_mic_title">माइक / असिस्टंट बटण</string>
