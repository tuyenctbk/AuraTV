    <string name="create_category_hint">Nieuwe mapnaam maken...</string>
    <string name="banner_dialog_title">Bannerherstel: %1$s</string>
    <string name="banner_dialog_desc">Voer het lokale bestandspad of de afbeeldings-URL in voor een aangepaste 16:9-banner.
Tip: Sla afbeeldingen op in /sdcard/GhostLauncher/Banners/%1$s.png voor automatische detectie.</string>
