    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Trykk på D-Pad-kombinasjonen: OPP, OPP, NED, VENSTRE for å låse opp eller låse skjulte hvelvapplikasjoner.</string>
    <string name="help_mic_title">Mikrofon / Assistent-knapp</string>
