    <string name="vault_title">Lås opp Stealth Vault</string>
    <string name="vault_desc">Skriv inn kode (Standard: GHOST) eller trykk D-Pad-sekvens OPP, OPP, NED, VENSTRE på startskjermen.</string>
    <string name="vault_invalid_passcode">Ugyldig passord</string>
    <string name="transparency_title">App Discovery Transparency</string>
    <string name="transparency_desc">Aura TV krever tillatelse for å skanne installerte applikasjoner (QUERY_ALL_PACKAGES). Dette er nødvendig for automatisk å oppdage og vise både innebygde TV-apper og sidelastede mobilapper på enheten din.

Aura TV er 100 % åpen kildekode, annonsefri og respekterer personvernet ditt. Ingen personopplysninger eller appliste blir noen gang samlet inn eller overført.</string>
    <string name="transparency_accept">Jeg forstår og godtar</string>
    <string name="onboarding_welcome_title">Velkommen til Aura TV</string>
    <string name="onboarding_welcome_desc">En lynrask, minimalistisk Android TV-starter designet for uanstrengt navigering, dyp tilpasning og ren estetikk.</string>
    <string name="onboarding_cats_title">Smart app-kategorier</string>
    <string name="onboarding_cats_desc">Organiser strømmeappene, spillene og sidelastede verktøyene dine pent i egendefinerte radseksjonsoverskrifter med live apptellinger.</string>
    <string name="onboarding_oled_title">OLED-innbrenningsbeskyttelse</string>
    <string name="onboarding_oled_desc">Beskytt TV-skjermen din med konfigurerbare inaktivitetstidtakere som automatisk utløser en OLED-sikker omgivelsessvart skjerm.</string>
