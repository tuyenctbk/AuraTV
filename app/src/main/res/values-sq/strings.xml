    <string name="help_dpad_title">Shigjetat D-Pad (lart / poshtë / majtas / djathtas)</string>
    <string name="help_dpad_desc">Lundroni nëpër rrjetën e ikonave të aplikacioneve, shiritin e sipërm të kokës, shiritin e kërkimit dhe dosjet e kategorive të personalizuara.</string>
    <string name="help_long_press_title">Shtypni gjatë OK / Zgjidh</string>
    <string name="help_long_press_desc">Hap menynë e kontekstit të aplikacionit për të aktivizuar Deep Stop, për të vendosur tastet kryesore të personalizuara ose për të modifikuar banderola të personalizuara.</string>
    <string name="help_settings_title">Tasti i menysë / Ikona e cilësimeve</string>
    <string name="help_settings_desc">Hap \"Cilësimet e nisësit\" (motori i sfondit 4K, ngjyrat e personalizuara të theksit, pastrues i kujtesës së performancës).</string>
    <string name="help_hotkey_title">Çelësat me numra (0 - 9)</string>
    <string name="help_hotkey_desc">Lëshon menjëherë aplikacionet e tastave kryesore të hartuara nga kudo në lëshues.</string>
    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Shtypni kombinimin D-Pad: LARTË, LARTË, POSHTË, LEFT për të zhbllokuar ose kyçur aplikacionet e fshehura të kasafortës.</string>
    <string name="help_mic_title">Butoni i mikrofonit / asistentit</string>
    <string name="help_mic_desc">Aktivizon dëgjuesin e kërkimit zë në tekst në telekomandat e mbështetura të Android TV.</string>
    <string name="vault_title">Zhbllokimi i kasafortës së fshehtë</string>
    <string name="vault_desc">Futni kodin (e parazgjedhur: GHOST) ose shtypni sekuencën e D-Pad LARTË, LARTË, POSHTË, LEFT në ekranin bazë.</string>
    <string name="vault_invalid_passcode">Kodkalimi i pavlefshëm</string>
    <string name="transparency_title">Transparenca e zbulimit të aplikacionit</string>
    <string name="transparency_desc">Aura TV kërkon leje për të skanuar aplikacionet e instaluara (QUERY_ALL_PACKAGES). Kjo është e nevojshme për të zbuluar dhe shfaqur automatikisht në pajisjen tuaj si aplikacionet vendase të TV ashtu edhe aplikacionet celulare të anashkaluara.

Aura TV është 100% me burim të hapur, pa reklama dhe respekton privatësinë tuaj. Asnjë listë e të dhënave personale apo aplikacioneve nuk është mbledhur apo transmetuar ndonjëherë.</string>
    <string name="transparency_accept">Unë e kuptoj dhe pranoj</string>
    <string name="onboarding_welcome_title">Mirë se vini në Aura TV</string>
    <string name="onboarding_welcome_desc">Një lëshues i shpejtë rrufe, minimalist i Android TV, i krijuar për navigim të lehtë, personalizim të thellë dhe estetikë të pastër.</string>
    <string name="onboarding_cats_title">Kategoritë e aplikacioneve inteligjente</string>
    <string name="onboarding_cats_desc">Organizoni mjeshtërisht aplikacionet tuaja të transmetimit, lojërat dhe shërbimet e ngarkuara anësore në titujt e seksioneve të rreshtave të personalizuar me numërimin e aplikacioneve të drejtpërdrejta.</string>
    <string name="onboarding_oled_title">Mbrojtje nga djegia OLED</string>
    <string name="onboarding_oled_desc">Mbroni ekranin e televizorit tuaj me kohëmatës të konfigurueshëm joaktiviteti që aktivizojnë automatikisht një ekran të zi të ambientit të sigurt për OLED.</string>
    <string name="hotkey_dialog_title">Tasti i drejtpërdrejtë i hartës: %1$s</string>
    <string name="hotkey_dialog_desc">Shtypni një buton numerik të telekomandës (0-9) në lëshuesin për ta nisur menjëherë këtë aplikacion.</string>
    <string name="category_dialog_title">Kategoria dinamike: %1$s</string>
    <string name="category_dialog_desc">Zgjidhni një dosje ekzistuese të kategorisë ose shkruani një të re.</string>
    <string name="create_category_hint">Krijo një emër të ri dosjeje...</string>
