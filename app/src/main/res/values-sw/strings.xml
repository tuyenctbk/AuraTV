    <string name="help_dpad_title">Mishale ya D-Pad (Juu / Chini / Kushoto / Kulia)</string>
    <string name="help_dpad_desc">Nenda kupitia gridi ya aikoni za programu, upau wa kichwa cha juu, upau wa kutafutia na folda maalum za kategoria.</string>
    <string name="help_long_press_title">Bonyeza Sawa / Chagua kwa muda mrefu</string>
    <string name="help_long_press_desc">Hufungua Menyu ya Muktadha wa Programu ili kuanzisha Deep Stop, kuweka vitufe maalum, au kubadilisha mabango maalum.</string>
    <string name="help_settings_title">Kitufe cha Menyu / Aikoni ya Mipangilio</string>
    <string name="help_settings_desc">Hufungua Mipangilio ya Kizinduzi (injini ya Mandhari ya 4K, rangi maalum za lafudhi, kisafisha akiba ya utendaji).</string>
    <string name="help_hotkey_title">Vifunguo vya Nambari (0 - 9)</string>
    <string name="help_hotkey_desc">Inazindua papo hapo programu za hotkey zilizowekwa kwenye ramani kutoka mahali popote kwenye kizindua.</string>
    <string name="help_vault_title">Stealth Vault Combo</string>
    <string name="help_vault_desc">Bonyeza mchanganyiko wa D-Pad: JUU, JUU, CHINI, KUSHOTO ili kufungua au kufunga programu za kubana zilizofichwa.</string>
    <string name="help_mic_title">Kitufe cha Maikrofoni / Msaidizi</string>
    <string name="help_mic_desc">Huanzisha kisikilizaji cha utafutaji wa sauti-hadi-maandishi kwenye vidhibiti vya mbali vya Android TV.</string>
    <string name="vault_title">Stealth Vault Unlock</string>
    <string name="vault_desc">Weka msimbo (Chaguo-msingi: GHOST) au ubonyeze mlolongo wa D-Pad JUU, JUU, CHINI, KUSHOTO kwenye skrini ya kwanza.</string>
    <string name="vault_invalid_passcode">Nambari ya siri isiyo sahihi</string>
    <string name="transparency_title">Uwazi wa Ugunduzi wa Programu</string>
    <string name="transparency_desc">Aura TV inahitaji ruhusa ili kuchanganua programu zilizosakinishwa (QUERY_ALL_PACKAGES). Hii ni muhimu ili kutambua kiotomatiki na kuonyesha programu asili za TV na programu za simu zilizopakiwa kwenye kifaa chako.

Aura TV haina programu huria 100%, haina matangazo na inaheshimu faragha yako. Hakuna data ya kibinafsi au orodha ya programu inayokusanywa au kusambazwa.</string>
    <string name="transparency_accept">Naelewa &amp; Nakubali</string>
    <string name="onboarding_welcome_title">Karibu kwenye Aura TV</string>
    <string name="onboarding_welcome_desc">Kizinduzi cha Android TV cha haraka sana na kisicho na kiwango kidogo kilichoundwa kwa ajili ya usogezaji rahisi, ubinafsishaji wa kina na urembo safi.</string>
    <string name="onboarding_cats_title">Aina za Programu Mahiri</string>
    <string name="onboarding_cats_desc">Panga programu zako za utiririshaji, michezo na huduma zilizopakiwa kwa uangalifu katika vichwa vya sehemu ya safu mlalo maalum kwa hesabu za programu moja kwa moja.</string>
    <string name="onboarding_oled_title">Ulinzi wa Kuchoma kwa OLED</string>
    <string name="onboarding_oled_desc">Linda onyesho lako la TV kwa kutumia vipima muda vinavyoweza kusanidiwa ambavyo huanzisha skrini nyeusi tulivu iliyo salama ya OLED kiotomatiki.</string>
    <string name="hotkey_dialog_title">Hotkey ya Ramani: %1$s</string>
    <string name="hotkey_dialog_desc">Bonyeza kitufe cha nambari ya mbali (0-9) kwenye kizindua ili kuzindua programu hii papo hapo.</string>
    <string name="category_dialog_title">Aina Inayobadilika: %1$s</string>
    <string name="category_dialog_desc">Chagua folda ya kategoria iliyopo au charaza mpya.</string>
    <string name="create_category_hint">Unda jina la folda mpya...</string>
    <string name="banner_dialog_title">Kirekebisha Bango: %1$s</string>
    <string name="banner_dialog_desc">Weka njia ya faili ya ndani au URL ya picha kwa bango maalum la 16:9.
Kidokezo: Hifadhi picha kwenye /sdcard/AuraTV/Banners/%1$s.png kwa utambuzi wa kiotomatiki.</string>
