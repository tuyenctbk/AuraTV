    <string name="help_long_press_desc">Mở Menu ngữ cảnh ứng dụng để kích hoạt Deep Stop, đặt phím nóng tùy chỉnh hoặc chỉnh sửa biểu ngữ tùy chỉnh.</string>
    <string name="help_settings_title">Phím Menu / Biểu tượng Cài đặt</string>
    <string name="help_settings_desc">Mở Cài đặt trình khởi chạy (Công cụ hình nền 4K, màu nhấn tùy chỉnh, trình dọn dẹp bộ đệm hiệu suất).</string>
    <string name="help_hotkey_title">Phím số (0 - 9)</string>
    <string name="help_hotkey_desc">Khởi chạy ngay lập tức các ứng dụng phím nóng được ánh xạ từ mọi nơi trên trình khởi chạy.</string>
    <string name="help_vault_title">Combo hầm tàng hình</string>
    <string name="help_vault_desc">Nhấn tổ hợp D-Pad: LÊN, LÊN, XUỐNG, TRÁI để mở khóa hoặc khóa các ứng dụng vault ẩn.</string>
    <string name="help_mic_title">Nút Mic/Trợ lý</string>
    <string name="help_mic_desc">Kích hoạt trình nghe tìm kiếm chuyển giọng nói thành văn bản trên điều khiển từ xa Android TV được hỗ trợ.</string>
    <string name="vault_title">Mở khóa hầm tàng hình</string>
    <string name="vault_desc">Nhập mã (Mặc định: GHOST) hoặc nhấn dãy D-Pad LÊN, LÊN, XUỐNG, TRÁI trên màn hình chính.</string>
    <string name="vault_invalid_passcode">Mật mã không hợp lệ</string>
    <string name="transparency_title">Tính minh bạch của việc khám phá ứng dụng</string>
    <string name="transparency_desc">Aura TV yêu cầu quyền quét các ứng dụng đã cài đặt (QUERY_ALL_PACKAGES). Điều này là cần thiết để tự động phát hiện và hiển thị cả ứng dụng TV gốc và ứng dụng di động được tải sẵn trên thiết bị của bạn.

Aura TV là nguồn mở 100%, không có quảng cáo và tôn trọng quyền riêng tư của bạn. Không có dữ liệu cá nhân hoặc danh sách ứng dụng nào được thu thập hoặc truyền đi.</string>
    <string name="transparency_accept">Tôi hiểu và chấp nhận</string>
    <string name="onboarding_welcome_title">Chào mừng đến với Aura TV</string>
    <string name="onboarding_welcome_desc">Trình khởi chạy Android TV tối giản, nhanh như chớp được thiết kế để điều hướng dễ dàng, tùy chỉnh sâu và có tính thẩm mỹ rõ ràng.</string>
    <string name="onboarding_cats_title">Danh mục ứng dụng thông minh</string>
    <string name="onboarding_cats_desc">Sắp xếp các ứng dụng phát trực tuyến, trò chơi và tiện ích đã tải sẵn của bạn một cách gọn gàng vào tiêu đề phần hàng tùy chỉnh cùng với số lượng ứng dụng trực tiếp.</string>
    <string name="onboarding_oled_title">Bảo vệ chống cháy OLED</string>
    <string name="onboarding_oled_desc">Bảo vệ màn hình TV của bạn bằng bộ hẹn giờ không hoạt động có thể định cấu hình để tự động kích hoạt màn hình đen xung quanh an toàn với OLED.</string>
    <string name="hotkey_dialog_title">Phím nóng bản đồ: %1$s</string>
    <string name="hotkey_dialog_desc">Nhấn phím số từ xa (0-9) trên trình khởi chạy để khởi chạy ngay ứng dụng này.</string>
